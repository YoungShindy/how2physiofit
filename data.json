              "detail": null,
              "children": [
                {
                  "id": "zehnertest-hand",
                  "title": "10er-Test Handwurzelknochen – Ossa carpi",
                  "image": "",
                  "children": [],
                  "detail": {
                    "media": "https://youtu.be/ADBW2oyjwLo?is=FaU-ERKyLrfQiE7K",
                    "regions": [
                      "region-hand"
                    ],
                    "sections": [
                      {
                        "heading": "Ziel",
                        "bullets": [
                          "Systematisches Benennen und Palpieren aller 8 Handwurzelknochen (Ossa carpi)",
                          "Wird genutzt, um Tastbefund und Anatomie-Wissen zu prüfen bzw. zu trainieren"
                        ]
                      },
                      {
                        "heading": "Proximale Reihe (radial → ulnar)",
                        "bullets": [
                          "Kahnbein — Os scaphoideum",
                          "Mondbein — Os lunatum",
                          "Dreiecksbein — Os triquetrum",
                          "Erbsenbein — Os pisiforme"
                        ]
                      },
                      {
                        "heading": "Distale Reihe (radial → ulnar)",
                        "bullets": [
                          "Großes Vieleckbein — Os trapezium",
                          "Kleines Vieleckbein — Os trapezoideum",
                          "Kopfbein — Os capitatum",
                          "Hakenbein — Os hamatum"
                        ]
                      },
                      {
                        "heading": "Palpationshinweis",
                        "bullets": [
                          "Kahnbein gut in der Tabatière (Foveola radialis) tastbar",
                          "Erbsenbein liegt oberflächlich auf dem Triquetrum, gut palpabel an der ulnaren Handgelenksbeugefalte",
                          "Hakenbein über seinen Hamulus (Hakenfortsatz) an der Hohlhand tastbar"
                        ]
                      }
                    ]
                  }
                }
              ]
