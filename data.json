            {
              "id": "sacrum",
              "title": "Sakrum",
              "image": "",
              "detail": null,
              "children": [
                {
                  "id": "nutation-verb",
                  "title": "Verbesserung Nutation – Nutatio",
                  "image": "",
                  "children": [],
                  "detail": {
                    "media": [
                      "videos/nutation.mp4"
                    ],
                    "regions": [
                      "region-becken-isg"
                    ],
                    "sections": [
                      {
                        "heading": "Was ist Nutation",
                        "bullets": [
                          "Kippbewegung des Os sacrum: Sacrumbasis (S1/S2) kippt nach ventral-kaudal, die Spitze (Apex/Steißbein) nach dorsal",
                          "Physiologische Bewegung u.a. bei Rumpfvorneigung/Flexion der LWS"
                        ]
                      },
                      {
                        "heading": "Handanlage",
                        "bullets": [
                          "Beide Daumen/Finger im Bereich der Sacrumbasis, nahe der SIPS beidseits aufgesetzt",
                          "Patient in Bauchlage, entspannt"
                        ]
                      },
                      {
                        "heading": "Ausführung",
                        "bullets": [
                          "Sanfter, rhythmischer Druckimpuls auf die Sacrumbasis nach ventral-kaudal, um die Nutationsbewegung zu unterstützen/testen",
                          "Seitenvergleich: Beweglichkeit und Endgefühl links/rechts vergleichen"
                        ]
                      }
                    ]
                  }
                },
                {
                  "id": "kontranutation-verb",
                  "title": "Verbesserung Kontranutation – Contranutatio",
                  "image": "",
                  "children": [],
                  "detail": {
                    "media": [
                      "videos/kontranutation.mp4"
                    ],
                    "regions": [
                      "region-becken-isg"
                    ],
                    "sections": [
                      {
                        "heading": "Was ist Kontranutation",
                        "bullets": [
                          "Gegenbewegung zur Nutation: Sacrumbasis (S1/S2) kippt nach dorsal-kranial, die Spitze (Apex/Steißbein) nach ventral",
                          "Physiologische Bewegung u.a. bei Rumpfaufrichtung/Extension der LWS"
                        ]
                      },
                      {
                        "heading": "Handanlage",
                        "bullets": [
                          "Kontakt beidseits im Bereich der Sacrumbasis bzw. am Übergang zum Os ilium",
                          "Patient in Bauchlage, entspannt, Becken gut unterstützt"
                        ]
                      },
                      {
                        "heading": "Ausführung",
                        "bullets": [
                          "Sanfter, rhythmischer Druckimpuls auf die Sacrumbasis nach dorsal-kranial, um die Kontranutation zu unterstützen/testen",
                          "Seitenvergleich: Beweglichkeit und Endgefühl links/rechts vergleichen"
                        ]
                      }
                    ]
                  }
                },
                {
                  "id": "kontralat-gegennutation-verb",
                  "title": "Verbesserung kontralaterale Gegennutation – Contranutatio contralateralis",
                  "image": "",
                  "children": [],
                  "detail": {
                    "media": "",
                    "regions": [
                      "region-becken-isg"
                    ],
                    "sections": []
                  }
                },
                {
                  "id": "sacrum-mob-cranial",
                  "title": "Sacrum Mobilisation nach cranial – Mobilisatio ossis sacri cranialis",
                  "image": "",
                  "children": [],
                  "detail": {
                    "media": [
                      "videos/sacrum-mobilisation-cranial.mp4"
                    ],
                    "regions": [
                      "region-becken-isg"
                    ],
                    "sections": [
                      {
                        "heading": "Was passiert",
                        "bullets": [
                          "Mobilisation des Os sacrum nach kranial (kopfwärts) gegenüber dem Becken",
                          "Patient in Bauchlage, Becken auf der Bank fixiert bzw. abgestützt"
                        ]
                      },
                      {
                        "heading": "Handanlage",
                        "bullets": [
                          "Kontakt-/Zughand auf dem Sacrum (meist im Bereich der Basis bzw. der Spina iliaca posterior superior)",
                          "Zweite Hand stabilisiert Becken/Bank als Widerlager"
                        ]
                      },
                      {
                        "heading": "Ausführung",
                        "bullets": [
                          "Kontrollierter Druck-/Zug-Impuls nach kranial direkt über das Sacrum",
                          "Dosierung je nach Ziel: leicht = schmerzlindernd, kräftiger = mobilisierend"
                        ]
                      }
                    ]
                  }
                },
                {
                  "id": "traktion-isg",
                  "title": "Traktion ISG – Tractio articulationis sacroiliacae (Gleiten nach kaudal)",
                  "image": "",
                  "children": [],
                  "detail": {
                    "media": [
                      "videos/traktion-isg-1.mp4",
                      "videos/traktion-isg-2.mp4"
                    ],
                    "regions": [
                      "region-becken-isg"
                    ],
                    "sections": [
                      {
                        "heading": "Was passiert",
                        "bullets": [
                          "Traktion (Tractio) am Iliosakralgelenk (ISG)",
                          "Kaudales Gleiten: das Os ilium wird gegenüber dem fixierten Os sacrum nach kaudal (fußwärts) gezogen",
                          "Video 1 und Video 2 zeigen dieselbe Technik/Handanlage aus zwei verschiedenen Kamera-Perspektiven"
                        ]
                      }
                    ]
                  }
                }
              ]
            },
