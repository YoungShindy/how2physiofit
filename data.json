              "id": "einpunkt-huefte-frontal",
              "title": "1-Punkt-Aufhängung Hüfte – Articulatio coxae",
              "image": "",
              "children": [],
              "detail": {
                "media": [
                  "videos/schlingentisch-1punkt-huefte.mp4"
                ],
                "regions": [
                  "region-huefte"
                ],
                "sections": [
                  {
                    "heading": "Aufgabe",
                    "bullets": [
                      "Einpunktaufhängung für die Hüfte durchführen"
                    ]
                  },
                  {
                    "heading": "Ausrichtung",
                    "bullets": [
                      "1-Punkt-Aufhängung der Hüfte in der Frontalebene",
                      "Nur Abduktion und Adduktion möglich"
                    ]
                  },
                  {
                    "heading": "Wichtig",
                    "bullets": [
                      "Seil muss direkt über dem Drehpunkt fixiert werden"
                    ]
                  },
                  {
                    "heading": "Wirkung auf die Hüfte",
                    "bullets": [
                      "Kompression, da Zugkraft ventro-kranial = resultierende Kraft"
                    ]
                  },
                  {
                    "heading": "Indikation bei Patienten mit",
                    "bullets": [
                      "Chronischer Hüftarthrose",
                      "Allgemeiner Hüftinstabilität",
                      "Lähmung/Schlaganfall — da Muskeln keinen Tonus haben",
                      "Kindern",
                      "Morbus Perthes",
                      "Hüftkopfnekrose/-veränderung"
                    ]
                  }
                ]
              }
            }
